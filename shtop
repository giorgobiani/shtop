                       floor=False)
            self.graph(ix, axis + 1, iw, uh_, [v / umax for v in uvals],
                       lambda f: mix(T.magenta, T.red, f * 0.5), down=True, glow=0, floor=False)
        if ih >= 2:
            foot = f"Since boot  ↓ {fmt_bytes(n.rx_total)}   ↑ {fmt_bytes(n.tx_total)}"
            s.put(ix, iy + ih - 1, trunc(foot, iw), T.dim)
            if n.ip and len(foot) + len(n.ip) + 4 <= iw:
                s.put(ix + iw - len(n.ip), iy + ih - 1, n.ip, T.fg)

    def draw_disks(self, x, y, w, h):
        s, T, dk, A = self.scr, self.theme, self.disks, self.anim
        self.panel(x, y, w, h, ICON["DISK"], "Storage", T.yellow)
        ix, iy, iw, ih = x + 2, y + 1, w - 4, h - 2
        mounts = dk.mounts
        rd, wr = A("rd", dk.read_rate), A("wr", dk.write_rate)
        io_rows = 1 if ih >= len(mounts) + 2 else 0
        if not mounts:
            s.put(ix, iy, "No drives found", T.dim)
            return
        two = ih - io_rows >= len(mounts) * 2
        name_w = min(12, max(len(Disks.label(m["mnt"])) for m in mounts))
        row = iy
        for m in mounts:
            if row >= iy + ih - io_rows:
                break
            frac = A("disk" + m["mnt"], m["frac"])
            lab = trunc(Disks.label(m["mnt"]), name_w)
            pct = f"{frac * 100:3.0f}%"
            s.put(ix, row, lab, T.fg)
            self.meter(ix + name_w + 1, row, iw - name_w - len(pct) - 2, frac, T.sev)
            s.put(ix + iw - len(pct), row, pct, T.sev(frac), bold=True)
            row += 1
            if two and row < iy + ih - io_rows:
                net = m["fs"] in ("9p", "virtiofs", "nfs", "nfs4", "cifs", "smb3")
                detail = (f"{fmt_bytes(m['free'])} free of {fmt_bytes(m['total'])}  ·  {m['mnt']}"
                          f"{'  (shared)' if net else ''}")
                s.put(ix + name_w + 1, row, trunc(detail, iw - name_w - 1), T.dim)
                row += 1
        if io_rows:
            ry = iy + ih - 1
            r_t, w_t = f"read {fmt_rate(rd)}", f"write {fmt_rate(wr)}"
            s.put(ix, ry, "●", T.green if rd > 1024 else T.track)
            s.put(ix + 2, ry, r_t, T.fg if rd > 1024 else T.dim)
            s.put(ix + 5 + len(r_t), ry, "●", T.orange if wr > 1024 else T.track)
            s.put(ix + 7 + len(r_t), ry, w_t, T.fg if wr > 1024 else T.dim)

    def draw_sys(self, x, y, w, h):
        s, T, A = self.scr, self.theme, self.anim
        self.panel(x, y, w, h, ICON["BOLT"], "Power & Sensors", T.orange)
        ix, iy, iw, ih = x + 2, y + 1, w - 4, h - 2
        lines = []  # (label, frac, value, colour or gradient, value colour, sub)
        b = self.bat
        if b.present:
            pct = A("bat", b.pct)
            col = T.green if b.status == "Charging" else T.sev(1 - pct / 100)
            grad = (lambda f: mix(mix(T.green, T.bg, 0.4), T.green, f)) if b.status == "Charging" \
                else (lambda f: T.sev(1 - f))
            lines.append((f"{b.icon()} Battery", pct / 100, f"{pct:.0f}%", grad, col, b.describe()))
        for i, g in enumerate(self.gpu.items):
            busy = A(f"gpu{i}", g[1])
            sub = f"VRAM {fmt_bytes(g[2])} / {fmt_bytes(g[3])}" if g[2] and g[3] else None
            lines.append((f"{ICON['GPU']} GPU", busy, f"{busy * 100:.0f}%", T.sev, T.sev(busy), sub))
        for label, c in self.sens.temps:
            c = A("t" + label, c)
            lines.append((f"{ICON['TEMP']} {label}", (c - 20) / 80, f"{c:.0f}°C",
                          lambda f: T.temp(20 + f * 80), T.temp(c), None))
        for label, rpm in self.sens.fans[:3]:
            lines.append((f"{ICON['FAN']} {label}", min(1, rpm / 6000), f"{rpm} rpm", T.cyan, T.cyan, None))
        if not lines:
            s.put(ix, iy, "No battery or sensors reported.", T.dim)
            if ih > 1:
                s.put(ix, iy + 1, trunc("Normal inside a virtual machine.", iw), T.dim)
            return
        need = sum(1 + (1 if line[5] else 0) for line in lines)
        row = iy
        lab_w = min(14, max(len(line[0]) for line in lines))
        for label, frac, val, grad, vcol, sub in lines:
            if row >= iy + ih:
                break
            s.put(ix, row, trunc(label, lab_w), T.fg)
            self.meter(ix + lab_w + 1, row, iw - lab_w - len(val) - 2, frac, grad)
            s.put(ix + iw - len(val), row, val, vcol, bold=True)
            row += 1
            if sub and need <= ih and row < iy + ih:
                s.put(ix + lab_w + 1, row, trunc(sub, iw - lab_w - 1), T.dim)
                row += 1

    # ── process table ──
    def columns(self, iw):
        if self.grouped:
            cols = [("name", "App", 0), ("count", "Procs", 5), ("cpu", "CPU", 13), ("trend", "Trend", 10),
                    ("mem", "Memory", 16), ("user", "User", 10)]
            if iw > 120:
                cols.append(("cmd", "Command", 0))
        else:
            cols = [("name", "Name", 0), ("pid", "PID", 8), ("cpu", "CPU", 13), ("trend", "Trend", 10),
                    ("mem", "Memory", 16), ("state", "State", 10), ("user", "User", 10), ("cmd", "Command", 0)]
        if iw < 100:
            cols = [c for c in cols if c[0] not in ("cmd", "state")]
        if iw < 76:
            cols = [c for c in cols if c[0] not in ("user", "trend")]
        fixed = sum(c[2] + 1 for c in cols if c[2])
        flex = [c for c in cols if not c[2]]
        rest = max(8, iw - fixed - len(flex))
        out = []
        for key, title, width in cols:
            if not width:
                if key == "name" and len(flex) > 1:
                    width = max(16, min(30, rest // 3))
                elif key == "name":
                    width = rest
                else:
                    width = max(0, rest - max(16, min(30, rest // 3)))
            out.append((key, title, width))
        return out

    def draw_procs(self, x, y, w, h):
        s, T = self.scr, self.theme
        total = len([p for p in self.procs.list if self.show_kernel or not p.kernel])
        right = (f"{len(self.rows)} apps · {total} processes" if self.grouped
                 else f"{len(self.rows)} processes")
        if self.filter:
            right = f"{ICON['SEARCH']} “{self.filter}” · " + right
        self.panel(x, y, w, h, ICON["APPS"], "Apps" if self.grouped else "Processes", T.accent, right,
                   T.accent if self.filter else None)
        ix, iy, iw, ih = x + 2, y + 1, w - 4, h - 2
        cols = self.columns(iw)
        cx = ix
        self.header_hits = []
        for key, title, width in cols:
            arrow = ""
            if key == self.sort:
                desc = (key in ("cpu", "mem", "count")) != self.reverse
                arrow = " ▾" if desc else " ▴"
            text = title + arrow
            if key in ("count", "pid"):
                tx = cx + width - len(text)
            elif key == "mem":
                tx = cx + 10 - len(text)
            elif key == "name":
                tx = cx + 2
            else:
                tx = cx
            s.put(tx, iy, trunc(text, width), T.accent if key == self.sort else T.dim, bold=key == self.sort)
            if key in SORTS:
                self.header_hits.append((cx, cx + width, key))
            cx += width + 1
        vis = ih - 1
        if vis <= 0:
            return
        if self.sel < self.scroll:
            self.scroll = self.sel
        if self.sel >= self.scroll + vis:
            self.scroll = self.sel - vis + 1
        self.scroll = max(0, min(self.scroll, max(0, len(self.rows) - vis)))
        self.table = (iy + 1, vis, self.scroll, iy)
        me = self.procs.user(os.getuid())
        for i, r in enumerate(self.rows[self.scroll:self.scroll + vis]):
            ry = iy + 1 + i
            selected = self.scroll + i == self.sel
            if selected:
                s.fill(x + 1, ry, w - 2, 1, T.sel)
                s.put(x + 1, ry, "▌", T.accent)
            cx = ix
            for key, _title, width in cols:
                if width <= 0:
                    continue
                if key == "name":
                    icon, icol = app_icon(r.name, r.kernel, T)
                    s.put(cx, ry, icon, icol)
                    s.put(cx + 2, ry, trunc(r.name, width - 2), T.bright if selected else T.fg, bold=selected)
                elif key == "count":
                    t = str(r.count) if r.count > 1 else ""
                    s.put(cx + width - len(t), ry, t, T.dim)
                elif key == "pid":
                    t = str(r.pid)
                    s.put(cx + width - len(t), ry, t, T.dim)
                elif key == "cpu":
                    v = r.cpu
                    if v >= 0.0005:
                        self.meter(cx, ry, 6, min(1.0, v * 2), T.sev, mix(T.track, T.bg, 0.3))
                        s.put(cx + 7, ry, f"{v * 100:5.1f}%", T.sev(min(1.0, v * 1.5)))
                    else:
                        s.put(cx + 7, ry, "    –", T.muted)
                elif key == "trend":
                    hist = self.trend.get(r.key, ())
                    if any(v > 0.001 for v in hist):
                        self.spark(cx, ry, width - 1, hist, T.sev)
                    else:
                        s.put(cx, ry, "·" * (width - 1), mix(T.muted, T.sel if selected else T.bg, 0.4))
                elif key == "mem":
                    f = r.mem / self.mem.total
                    t = fmt_bytes(r.mem)
                    col = T.sev(min(1.0, f * 2.5)) if f >= 0.05 else T.fg
                    s.put(cx + 10 - len(t), ry, t, col)
                    if f >= 0.005:
                        self.meter(cx + 11, ry, 5, min(1.0, f * 4),
                                   lambda p: mix(mix(T.magenta, T.bg, 0.4), T.magenta, p), mix(T.track, T.bg, 0.3))
                elif key == "state":
                    st = r.state
                    col = {"R": T.green, "D": T.yellow, "Z": T.red, "T": T.orange}.get(st, T.dim)
                    s.put(cx, ry, "●", col)
                    s.put(cx + 2, ry, trunc(STATES.get(st, st), width - 2), col if st in "RDZT" else T.dim)
                elif key == "user":
                    col = T.dim if r.user == me else (T.orange if r.user == "root" else T.yellow)
                    s.put(cx, ry, trunc(r.user, width), col)
                elif key == "cmd":
                    s.put(cx, ry, trunc(r.cmd, width), mix(T.dim, T.bg, 0.1))
                cx += width + 1
        if not self.rows:
            msg = f"Nothing matches “{self.filter}”" if self.filter else "No processes"
            s.put(ix + (iw - len(msg)) // 2, iy + vis // 2, msg, T.dim)
        if len(self.rows) > vis:
            th = max(1, vis * vis // len(self.rows))
            ty = iy + 1 + (vis - th) * self.scroll // max(1, len(self.rows) - vis)
            for yy in range(iy + 1, iy + 1 + vis):
                on = ty <= yy < ty + th
                s.put(x + w - 1, yy, "┃" if on else "│", T.accent if on else mix(T.accent, T.bg, 0.6))

    # ── overlays ──
    def modal(self, w, h, title, color, icon=""):
        W, H = self.scr.w, self.scr.h
        w, h = min(w, W - 4), min(h, H - 2)
        x, y = (W - w) // 2, (H - h) // 2
        s, T = self.scr, self.theme
        s.fill(x, y, w, h, T.bg)
        s.put(x, y, "╭" + "─" * (w - 2) + "╮", color, T.bg)
        for r in range(1, h - 1):
            s.put(x, y + r, "│", color, T.bg)
            s.put(x + w - 1, y + r, "│", color, T.bg)
        s.put(x, y + h - 1, "╰" + "─" * (w - 2) + "╯", color, T.bg)
        self.pill(x + 2, y, f"{icon} {title}" if icon else title, color)
        return x + 2, y + 1, w - 4, h - 2

    def draw_detail(self):
        r = self.current()
        if not r:
            self.overlay = None
            return
        s, T = self.scr, self.theme
        icon, icol = app_icon(r.name, r.kernel, T)
        ix, iy, iw, ih = self.modal(92, 28, r.name, T.accent, icon)
        bg = T.bg
        row = iy + 1

        def kv(label, value, col=None):
            nonlocal row
            if row >= iy + ih - 2:
                return
            s.put(ix + 1, row, label, T.dim, bg)
            s.put(ix + 15, row, trunc(str(value), iw - 16), col or T.fg, bg)
            row += 1

        # CPU history chart for this app/process
        hist = list(self.trend.get(r.key, ()))
        if ih >= 16:
            gh = 4
            s.put(ix + 1, row, "CPU over the last minute", T.dim, bg)
            peak = max(hist + [0.0])
            s.put(ix + iw - 12, row, f"peak {peak * 100:4.1f}%", T.dim, bg)
            row += 1
            scale = max(0.05, peak * 1.15)
            s.put(ix + 1, row + gh // 2 - 0, "┈" * (iw - 2), mix(T.muted, T.bg, 0.45), bg)
            self.graph(ix + 1, row, iw - 2, gh, [v / scale for v in hist], T.sev)
            row += gh + 1

        f = r.mem / self.mem.total
        if r.count > 1:
            kv("Processes", r.count)
            kv("CPU", f"{r.cpu * 100:.1f}% of the whole machine", T.sev(min(1, r.cpu * 1.5)))
            kv("Memory", f"{fmt_bytes(r.mem)}  ({f * 100:.1f}% of RAM)")
            kv("Threads", r.threads)
            kv("User", r.user)
            row += 1
            if row < iy + ih - 2:
                s.put(ix + 1, row, f"{'PID':>8}  {'CPU':>6}  {'MEMORY':>9}  {'STATE':<9} COMMAND", T.dim, bg, bold=True)
                row += 1
            for p in sorted(r.procs, key=lambda p: (-p.cpu, -p.mem)):
                if row >= iy + ih - 2:
                    break
                line = f"{p.pid:>8}  {p.cpu * 100:5.1f}%  {fmt_bytes(p.mem):>9}  {STATES.get(p.state, p.state):<9} "
                s.put(ix + 1, row, line, T.fg, bg)
                s.put(ix + 1 + len(line), row, trunc(p.cmd, iw - len(line) - 2), T.dim, bg)
                row += 1
        else:
            parent = next((p for p in self.procs.list if p.pid == r.ppid), None)
            started = self.procs.btime + r.start / self.procs.clk
            kv("PID", r.pid)
            kv("Parent", f"{parent.name} ({r.ppid})" if parent else r.ppid)
            kv("User", r.user)
            kv("State", f"{STATES.get(r.state, r.state)} — {STATE_HELP.get(r.state, '')}")
            when = time.strftime("%a %H:%M", time.localtime(started))
            kv("Started", f"{fmt_dur(time.time() - started)} ago  ({when})")
            kv("CPU", f"{r.cpu * 100:.1f}% of the whole machine", T.sev(min(1, r.cpu * 1.5)))
            kv("Memory", f"{fmt_bytes(r.mem)}  ({f * 100:.1f}% of RAM)")
            kv("Threads", r.threads)
            for label, link in (("Program", "exe"), ("Folder", "cwd")):
                try:
                    kv(label, os.readlink(f"/proc/{r.pid}/{link}"))
                except OSError:
                    pass
            row += 1
            if row < iy + ih - 2:
                s.put(ix + 1, row, "Command", T.dim, bg)
                row += 1
            for line in textwrap.wrap(r.cmd, iw - 2) or [""]:
                if row >= iy + ih - 2:
                    break
                s.put(ix + 1, row, line, T.fg, bg)
                row += 1
        hx = ix + 1
        for k, label in [("del", "end"), ("shift+del", "force end"), ("↑↓", "browse"), ("esc", "close")]:
            hx += self.keycap(hx, iy + ih - 1, k, label) + 2

    def draw_confirm(self):
        row, sig = self.confirm
        s, T = self.scr, self.theme
        force = sig == signal.SIGKILL
        col = T.red if force else T.yellow
        n = f" ({row.count} processes)" if row.count > 1 else ""
        ix, iy, iw, ih = self.modal(64, 8, ("Force end " if force else "End ") + row.name + "?", col,
                                    ICON["WARN"] if force else ICON["INFO"])
        msg = ("Stops it immediately. Unsaved work will be lost." if force
               else "Asks it to close nicely, like clicking the close button.")
        icon, icol = app_icon(row.name, row.kernel, T)
        s.put(ix + 1, iy + 1, icon, icol, T.bg)
        s.put(ix + 3, iy + 1, trunc(row.name + n, iw - 4), T.bright, T.bg, bold=True)
        s.put(ix + 1, iy + 2, trunc(msg, iw - 2), T.fg, T.bg)
        x = ix + 1
        x += self.pill(x, iy + 4, " y  yes, end it ", col) + 2
        self.keycap(x, iy + 4, "n", "cancel")

