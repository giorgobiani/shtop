class Screen:
    """A cell buffer that only re-emits rows that changed since the last frame."""

    def __init__(self, w=80, h=24):
        self.resize(w, h)

    def resize(self, w, h):
        self.w, self.h = w, h
        self.prev = None
        self.clear()

    def clear(self):
        w, h = self.w, self.h
        self.ch = [[" "] * w for _ in range(h)]
        self.fg = [[None] * w for _ in range(h)]
        self.bg = [[None] * w for _ in range(h)]
        self.bd = [[False] * w for _ in range(h)]

    def put(self, x, y, s, fg=None, bg=KEEP, bold=False):
        if y < 0 or y >= self.h:
            return
        ch, fgr, bgr, bdr = self.ch[y], self.fg[y], self.bg[y], self.bd[y]
        for i, c in enumerate(s):
            xx = x + i
            if 0 <= xx < self.w:
                ch[xx] = c
                fgr[xx] = fg
                bdr[xx] = bold
                if bg is not KEEP:
                    bgr[xx] = bg

    def put_soft(self, x, y, s, fg=None):
        """Write only over empty cells (labels that must not hide graph bars)."""
        if 0 <= y < self.h:
            for i, c in enumerate(s):
                xx = x + i
                if 0 <= xx < self.w and self.ch[y][xx] in " ┈":
                    self.ch[y][xx], self.fg[y][xx], self.bd[y][xx] = c, fg, False

    def fill(self, x, y, w, h, bg):
        for yy in range(max(0, y), min(self.h, y + h)):
            for xx in range(max(0, x), min(self.w, x + w)):
                self.ch[yy][xx] = " "
                self.bg[yy][xx] = bg
                self.fg[yy][xx] = None

    @staticmethod
    def _sgr(fg, bg, bold):
        p = ["0"]
        if bold:
            p.append("1")
        p.append("38;2;{};{};{}".format(*fg) if fg else "39")
        p.append("48;2;{};{};{}".format(*bg) if bg else "49")
        return "\x1b[" + ";".join(p) + "m"

    def _row(self, y):
        out, cur = [], None
        for c, f, b, d in zip(self.ch[y], self.fg[y], self.bg[y], self.bd[y], strict=True):
            st = (f, b, d)
            if st != cur:
                out.append(self._sgr(f, b, d))
                cur = st
            out.append(c)
        return "".join(out)

    def flush(self):
        rows = [tuple(zip(self.ch[y], self.fg[y], self.bg[y], self.bd[y], strict=True)) for y in range(self.h)]
        buf = ["\x1b[?2026h"]
        for y in range(self.h):
            if self.prev is not None and self.prev[y] == rows[y]:
                continue
            buf.append(f"\x1b[{y + 1};1H")
            buf.append(self._row(y))
        buf.append("\x1b[0m\x1b[?2026l")
        self.prev = rows
        data = "".join(buf).encode()
        while data:
            n = os.write(sys.stdout.fileno(), data)
            data = data[n:]

    def dump(self):
        return "\n".join(self._row(y) + "\x1b[0m" for y in range(self.h)) + "\n"


