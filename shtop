        n = self.cpu.threads
        sections = [
            (ICON["CPU"], "CPU", T.blue, f"How hard the processor is working. The graph scrolls right-to-left; taller "
             f"and redder means busier. Each numbered bar is one core. Load = how many tasks want the CPU "
             f"(1, 5 and 15 minute averages) — anything under {n} means nothing is waiting."),
            (ICON["MEM"], "Memory", T.magenta, "In use is held by apps. Cache is spare RAM Linux uses to remember "
