                ("/", "search"), ("g", "apps ⇄ processes"), ("s", "next sort"),
                ("c m n p", "sort CPU/mem/name/PID"), ("r", "reverse sort"),
                ("del x", "end (nicely)"), ("shift+del X", "force end"),
                ("t", "kernel tasks"), ("a", "animations on/off"),
