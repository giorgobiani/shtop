SORTS = ["cpu", "mem", "name", "count", "pid"]
SORT_NAMES = {"cpu": "CPU", "mem": "Memory", "name": "Name", "count": "Procs", "pid": "PID"}


_icon_cache = {}


def app_icon(name, kernel, T):
    key = (name, kernel, id(T), T.stamp)
    hit = _icon_cache.get(key)
    if hit is None:
        if len(_icon_cache) > 4000:
            _icon_cache.clear()
        hit = _icon_cache[key] = _app_icon(name, kernel, T)
    return hit


def _app_icon(name, kernel, T):
    if kernel:
        return ICON["KERNEL"], T.muted
    n = name.lower()
    for names, icon, col in APP_ICONS:
        for k in names:
            if n == k or (len(k) > 4 and n.startswith(k)):
                return (icon if ICONS_ON else "●"), getattr(T, col)
    palette = [T.blue, T.cyan, T.green, T.yellow, T.magenta, T.orange, T.red]
    return "●", mix(palette[zlib.crc32(n.encode()) % len(palette)], T.bg, 0.25)


class App:
    def __init__(self, theme=None, interval=1.0, animate=True):
        self.theme = theme or Theme()
        self.scr = Screen()
        self.anim = Anim()
        self.cpu, self.mem, self.net = CPU(), Memory(), Network()
        self.disks, self.sens, self.bat, self.gpu = Disks(), Sensors(), Battery(), GPU()
        self.procs = Procs(self.cpu.threads)
        self.hostname = socket.gethostname()
        self.interval = interval
        self.anim.enabled = animate
        self.grouped = True
        self.show_kernel = False
        self.sort, self.reverse = "cpu", False
        self.filter, self.filtering = "", False
        self.sel, self.sel_key, self.scroll = 0, None, 0
        self.picked = False  # until the user picks a row, the selection stays on top
        self.overlay = None
        self.confirm = None
        self.toast, self.toast_until = None, 0
        self.rows = []
        self.trend = {}  # row key -> deque of CPU shares, for sparklines
        self.table = None
        self.header_hits = []
        self.last_click = (0, None)
        self.running = True

    # ── data ──
    @property
    def fast_interval(self):
        return self.interval / 2

    def sample_fast(self):
        """CPU, memory and network: cheap, sampled twice per interval for smooth graphs."""
        now = time.monotonic()
        self.cpu.update()
        self.mem.update()
        self.net.update(now)
        if hasattr(self, "groups"):
            self._insight = self.insight()

    def sample(self):
        now = time.monotonic()
        self.disks.update(now)
        self.sens.update()
        self.bat.update()
        self.gpu.update(now)
        self.procs.update(now)
        self.groups = group([p for p in self.procs.list if not p.kernel and p.pid != os.getpid()])
        self.record_trends()
        self.build_rows()
        self._insight = self.insight()

    def record_trends(self):
        live = [p for p in self.procs.list]
        seen = set()
        for p in live:
            seen.add(p.pid)
            self.trend.setdefault(p.pid, deque(maxlen=60)).append(p.cpu)
        for g in self.groups:
            seen.add(g.name)
            self.trend.setdefault(g.name, deque(maxlen=60)).append(g.cpu)
        for k in [k for k in self.trend if k not in seen]:
            del self.trend[k]

    def build_rows(self):
        me = os.getpid()
        procs = [p for p in self.procs.list
                 if (self.show_kernel or not p.kernel) and p.pid != me]
        rows = group(procs) if self.grouped else procs
        if self.filter:
            f = self.filter.lower()
            rows = [r for r in rows if f in r.name.lower() or f in r.cmd.lower() or f == str(r.pid)]
        key = {
            "cpu": lambda r: (r.cpu, r.mem),
            "mem": lambda r: (r.mem, r.cpu),
            "name": lambda r: r.name.lower(),
            "count": lambda r: (r.count, r.cpu),
            "pid": lambda r: r.pid,
        }[self.sort]
        desc = self.sort in ("cpu", "mem", "count")
        rows.sort(key=key, reverse=desc != self.reverse)
        self.rows = rows
        if not self.picked:
            self.sel = 0
        elif self.sel_key is not None:
            for i, r in enumerate(rows):
                if r.key == self.sel_key:
                    self.sel = i
                    break
        self.sel = max(0, min(self.sel, len(rows) - 1))
        self.sel_key = rows[self.sel].key if rows else None

    def current(self):
        return self.rows[self.sel] if self.rows and 0 <= self.sel < len(self.rows) else None

    def move(self, d):
        if not self.rows:
            return
        self.sel = max(0, min(len(self.rows) - 1, self.sel + d))
        self.sel_key = self.rows[self.sel].key
        self.picked = True

    def say(self, msg, color=None, secs=4):
        self.toast = (msg, color)
        self.toast_until = time.monotonic() + secs

    def kill(self, row, sig):
        ok = denied = 0
        for p in row.procs:
            if p.pid in (1, os.getpid()):
                continue
            try:
                os.kill(p.pid, sig)
                ok += 1
            except PermissionError:
                denied += 1
            except ProcessLookupError:
                pass
        how = "Force-ended" if sig == signal.SIGKILL else "Asked to close"
        T = self.theme
        if denied and not ok:
            self.say(f"Not allowed to end {row.name} — it belongs to {row.user}. "
                     "Run shtop with sudo for that.", T.red, 6)
        elif denied:
            self.say(f"{how} {ok} of {ok + denied} {row.name} processes (no permission for the rest)", T.yellow, 6)
        else:
            n = f" ({ok} processes)" if ok > 1 else ""
            self.say(f"{how} {row.name}{n}", T.green)

    # ── drawing primitives ──
    def pill(self, x, y, text, color, fg=None, bold=True):
        """A rounded label:  text  — returns its width."""
        s = self.scr
        s.put(x, y, CAP_L, color)
        s.put(x + 1, y, text, fg or self.theme.bg, color, bold=bold)
        s.put(x + 1 + len(text), y, CAP_R, color)
        return len(text) + 2

    def soft_pill(self, x, y, text, color):
        """A tinted pill: coloured text on a faint wash of the same colour."""
        tint = mix(color, self.theme.bg, 0.82)
        return self.pill(x, y, text, tint, color, bold=False)

    def keycap(self, x, y, key, label):
        T, s = self.theme, self.scr
        s.put(x, y, f" {key} ", T.accent, T.sel, bold=True)
        s.put(x + len(key) + 3, y, label, T.dim)
        return len(key) + 3 + len(label)

    def panel(self, x, y, w, h, icon, title, color, right="", right_color=None):
        s, T = self.scr, self.theme
        B = mix(color, T.bg, 0.6)
        s.put(x, y, "╭" + "─" * (w - 2) + "╮", B)
        for r in range(1, h - 1):
            s.put(x, y + r, "│", B)
            s.put(x + w - 1, y + r, "│", B)
        s.put(x, y + h - 1, "╰" + "─" * (w - 2) + "╯", B)
        pw = self.pill(x + 2, y, f"{icon} {title}", color)
        room = w - pw - 8
        if right and room > 4:
            rr = f" {trunc(right, room - 2)} "
            s.put(x + w - 2 - len(rr), y, rr, right_color or T.dim)

    def meter(self, x, y, w, frac, color, track=None):
        """Thick line on a thin track. color may be a function of position (0..1)."""
        if w <= 0:
            return
        s, T = self.scr, self.theme
        n = max(0.0, min(1.0, frac)) * w
        full = int(n)
        half = n - full >= 0.5
        grad = callable(color)
        for i in range(w):
            c = color(i / max(1, w - 1)) if grad else color
            if i < full:
                s.put(x + i, y, "━", c)
            elif i == full and half:
                s.put(x + i, y, "╸", c)
            else:
                s.put(x + i, y, "─", track or T.track)

    def stacked(self, x, y, w, parts):
        total = sum(v for v, _ in parts) or 1
        pos, acc = x, 0.0
        for i, (v, c) in enumerate(parts):
            acc += v
            end = x + (w if i == len(parts) - 1 else round(acc / total * w))
            for xx in range(pos, end):
                col = c((xx - pos) / max(1, end - pos - 1)) if callable(c) else c
                self.scr.put(xx, y, "━" if c is not None else "─", col or self.theme.track)
            pos = end

    def graph(self, x, y, w, h, values, color_at, down=False, glow=0.6, floor=True):
        """Bar graph, newest sample on the right.

        Rows are coloured by height via color_at(f); lower rows fade towards the
        background and the top of every bar is drawn at full strength, which
        gives a soft glowing area chart."""
        if w <= 0 or h <= 0:
            return
        s, T = self.scr, self.theme
        vals = list(values)[-w:]
        off = x + w - len(vals)
        body = [mix(color_at((r + 0.5) / h), T.bg, glow * (1 - (r + 0.5) / h)) for r in range(h)]
        crest = [color_at((r + 0.5) / h) for r in range(h)]
        for i, v in enumerate(vals):
            total = max(0.0, min(1.0, v)) * h * 8
            if floor and v > 0.002 and total < 1:
                total = 1
            top = math.ceil(total / 8) - 1
            for r in range(top + 1):
                lvl = min(8, max(0, round(total - r * 8)))
                if not lvl:
                    break
                col = crest[r] if r == top else body[r]
                if not down:
                    s.put(off + i, y + h - 1 - r, BLOCKS[lvl], col)
                elif lvl == 8:
                    s.put(off + i, y + r, "█", col)
                else:
                    # grow downwards: paint the cell in the bar colour and cover the
                    # bottom with a background-coloured lower block
                    s.put(off + i, y + r, BLOCKS[8 - lvl], T.bg, col)

    def spark(self, x, y, w, values, color_at):
        vals = list(values)[-w:]
        off = x + w - len(vals)
        for i, v in enumerate(vals):
            f = min(1.0, v * 2)
            lvl = max(1 if v > 0.001 else 0, round(f * 8))
            if lvl:
                self.scr.put(off + i, y, BLOCKS[lvl], color_at(f))

    # ── header & footer ──
    def draw_header(self, W):
        s, T, A = self.scr, self.theme, self.anim
        s.put(1, 0, ICON["LOGO"], T.accent, bold=True)
        word = "shtop"
        for i, ch in enumerate(word):
            s.put(3 + i, 0, ch, mix(T.accent, T.magenta, i / (len(word) - 1)), bold=True)
        x = 3 + len(word) + 2
        s.put(x, 0, self.hostname, T.fg)
        x += len(self.hostname)
        s.put(x, 0, "  ·  ", T.muted)
        s.put(x + 5, 0, self.theme.name, T.dim)
        x += 5 + len(self.theme.name)

        up = float((read("/proc/uptime", "0") or "0").split()[0])
        chips = []
        if self.bat.present:
            pct = A("bat", self.bat.pct)
            col = T.green if self.bat.status == "Charging" else T.sev(1 - pct / 100)
            chips.append((f"{self.bat.icon()} {pct:.0f}%", col))
        chips.append((f"{ICON['CLOCK']} up {fmt_dur(up)}", T.dim))
        chips.append((time.strftime("%H:%M"), T.bright))
        rw = sum(len(t) for t, _ in chips) + 3 * (len(chips) - 1) + 1
        rx = W - rw
        for i, (text, col) in enumerate(chips):
            if i:
                s.put(rx, 0, " · ", T.muted)
                rx += 3
            s.put(rx, 0, text, col, bold=col == T.bright)
            rx += len(text)

        msg, col = getattr(self, "_insight", None) or self.insight()
        room = W - rw - x - 6
        if room > 14:
            text = " " + trunc(msg, room - 6) + " "
            pw = len(text) + 4
            cx = max(x + 2, (W - pw) // 2)
            if cx + pw > W - rw - 1:
                cx = x + 2
            tint = mix(col, T.bg, 0.82)
            s.put(cx, 0, CAP_L, tint)
            s.put(cx + 1, 0, " ●", col, tint)
            s.put(cx + 3, 0, text, T.bright, tint)
            s.put(cx + 3 + len(text), 0, CAP_R, tint)

    def insight(self):
        T = self.theme
        procs = getattr(self, "groups", [])
        top_cpu = max(procs, key=lambda p: p.cpu, default=None)
        top_mem = max(procs, key=lambda p: p.mem, default=None)
        cpu, memf = self.cpu.total, self.mem.used / self.mem.total
        full = [d for d in self.disks.mounts if d["frac"] > 0.92 and d["fs"] not in ("9p", "nfs", "nfs4", "cifs")]
        if cpu > 0.85 and top_cpu:
            return f"CPU is maxed out — {top_cpu.name} is using {top_cpu.cpu * 100:.0f}%", T.red
        if memf > 0.9 and top_mem:
            return f"Memory is almost full — {top_mem.name} holds {fmt_bytes(top_mem.mem)}", T.red
        if self.sens.cpu_temp and self.sens.cpu_temp >= 90:
            return f"CPU is running hot ({self.sens.cpu_temp:.0f}°C)", T.red
        if self.bat.present and self.bat.status == "Discharging" and self.bat.pct <= 15:
            return f"Battery low — {self.bat.pct}% left", T.red
        if full:
            return f"{Disks.label(full[0]['mnt'])} drive is almost full ({full[0]['frac'] * 100:.0f}%)", T.yellow
        if self.mem.swap_total and self.mem.swap_used / self.mem.swap_total > 0.5 and not self.mem.zram:
            return "Low on memory — the system is leaning on swap", T.yellow
        if memf > 0.75 and top_mem:
            return f"Memory is getting tight — biggest is {top_mem.name} ({fmt_bytes(top_mem.mem)})", T.yellow
        if cpu > 0.5 and top_cpu:
            return f"Busy — mostly {top_cpu.name} ({top_cpu.cpu * 100:.0f}% CPU)", T.yellow
        if cpu > 0.15 and top_cpu and top_cpu.cpu > 0.05:
            return f"Working lightly — {top_cpu.name} is most active", T.green
        return "All calm — nothing is working hard", T.green

    def draw_footer(self, W, H):
        s, T = self.scr, self.theme
        y = H - 1
        if self.filtering:
            x = 1 + self.pill(1, y, f"{ICON['SEARCH']} Search", T.accent)
            s.put(x + 1, y, self.filter, T.bright, bold=True)
            s.put(x + 1 + len(self.filter), y, "▏", T.accent)
            hx = W - 1
            for k, label in reversed([("⏎", "keep"), ("esc", "clear")]):
                hx -= len(k) + 3 + len(label) + 2
                self.keycap(hx, y, k, label)
            return
        if self.toast and time.monotonic() < self.toast_until:
            msg, col = self.toast
            self.soft_pill(1, y, f"● {trunc(msg, W - 6)}", col or T.accent)
            return
        keys = [("↑↓", "select"), ("⏎", "details"), ("/", "search"),
                ("g", "processes" if self.grouped else "group by app"),
                ("s", f"sort: {SORT_NAMES[self.sort]}"), ("del", "end"), ("?", "help"), ("q", "quit")]
        x = 1
        for k, label in keys:
            need = len(k) + 3 + len(label) + 2
            if x + need > W:
                break
            x += self.keycap(x, y, k, label) + 2
        if self.interval != 1.0 and x + 12 < W:
            t = f"every {self.interval:g}s"
            s.put(W - len(t) - 1, y, t, T.dim)

    # ── panels ──
    def draw_cpu(self, x, y, w, h):
        s, T, c, A = self.scr, self.theme, self.cpu, self.anim
        self.panel(x, y, w, h, ICON["CPU"], "CPU", T.blue, c.model)
        ix, iy, iw, ih = x + 2, y + 1, w - 4, h - 2
        pct = A("cpu", c.total)
        big = f"{pct * 100:.0f}%"
        word = ("idle" if c.total < 0.05 else "relaxed" if c.total < 0.25 else "working" if c.total < 0.5
                else "busy" if c.total < 0.85 else "maxed out")
        s.put(ix, iy, big, T.sev(pct), bold=True)
        s.put(ix + len(big) + 1, iy, word, T.fg)
        chips = []
        if c.freq:
            chips.append((f"{ICON['FREQ']} {A('freq', c.freq):.1f} GHz", T.cyan))
        if self.sens.cpu_temp:
            t = A("ctemp", self.sens.cpu_temp)
            chips.append((f"{ICON['TEMP']} {t:.0f}°C", T.temp(t)))
        rx = ix + iw
        for text, col in reversed(chips):
            pw = len(text) + 4
            if rx - pw < ix + len(big) + len(word) + 3:
                break
            rx -= pw
            self.soft_pill(rx, iy, f" {text} ", col)
            rx -= 1

        gh = ih - 2
        if gh >= 1:
            n = len(c.per)
            col_w = len(str(n)) + 1 + 6 + 5
            cols = -(-n // gh) if n else 0
            core_w = cols * (col_w + 2) if n else 0
            gw = iw
            if n and core_w <= iw * 0.45:
                cx0 = ix + iw - core_w + 2
                for i in range(n):
                    v = A(f"core{i}", c.per[i])
                    cx = cx0 + (i // gh) * (col_w + 2)
                    cy = iy + 1 + (i % gh)
                    lab = str(i + 1).rjust(len(str(n)))
                    s.put(cx, cy, lab, T.dim)
                    self.meter(cx + len(lab) + 1, cy, 6, v, T.sev)
                    s.put(cx + len(lab) + 8, cy, f"{v * 100:3.0f}%", T.sev(v) if v > 0.01 else T.dim)
                gw = iw - core_w - 1
            elif n and iw >= 30:
                per_row = max(1, (iw * 4 // 10) // 2)
                if -(-n // per_row) <= gh:
                    cx0 = ix + iw - per_row * 2 + 1
                    for i in range(n):
                        v = A(f"core{i}", c.per[i])
                        s.put(cx0 + (i % per_row) * 2, iy + 1 + i // per_row, "■",
                              T.sev(v) if v > 0.02 else T.track)
                    gw = iw - per_row * 2 - 2
            if gh >= 3:
                s.put(ix, iy + 1 + gh // 2, "┈" * gw, mix(T.muted, T.bg, 0.45))
            hist = list(c.hist)
            if hist:
                hist[-1] = A("cpu_last", hist[-1])
            self.graph(ix, iy + 1, gw, gh, hist, T.sev)
            if gh >= 3:
                span = fmt_dur(gw * self.fast_interval)
                s.put_soft(ix, iy + 1, f"last {span}", T.dim)
                if gw > 20:
                    s.put_soft(ix + gw - 4, iy + 1 + gh // 2, "50%", mix(T.muted, T.bg, 0.2))

        if ih >= 2:
            l1, l5, l15 = c.load
            parts = [("Load ", T.dim), (f"{l1:.2f}", T.sev(l1 / c.threads)),
                     (f"  {l5:.2f}  {l15:.2f}", T.fg), ("  ·  ", T.muted),
                     (f"{c.cores} cores / {c.threads} threads", T.dim),
                     ("  ·  ", T.muted), (f"{len(self.procs.list)} processes", T.dim)]
            px = ix
            for text, col in parts:
                text = trunc(text, ix + iw - px)
                s.put(px, iy + ih - 1, text, col)
                px += len(text)

    def draw_mem(self, x, y, w, h):
        s, T, m, A = self.scr, self.theme, self.mem, self.anim
        self.panel(x, y, w, h, ICON["MEM"], "Memory", T.magenta, f"{fmt_bytes(m.total)} total")
        ix, iy, iw, ih = x + 2, y + 1, w - 4, h - 2
        used, cache, free = A("m_used", m.used), A("m_cache", m.cache), A("m_free", m.free)
        frac = used / m.total
        u = fmt_bytes(used)
        s.put(ix, iy, u, T.sev(frac), bold=True)
        s.put(ix + len(u) + 1, iy, "in use", T.fg)
        avail = f"{fmt_bytes(m.avail)} available"
        p = f"{frac * 100:.0f}%"
        s.put(ix + iw - len(p), iy, p, T.sev(frac), bold=True)
        if iw - len(p) - len(u) - 10 > len(avail) + 2:
            s.put(ix + iw - len(p) - len(avail) - 3, iy, avail, T.dim)
        row = iy + 1
        def mag(f):
            return mix(mix(T.magenta, T.bg, 0.25), T.magenta, f)

        def cy_(f):
            return mix(mix(T.cyan, T.bg, 0.25), T.cyan, f)

        if ih >= 3:
            self.stacked(ix, row, iw, [(used, mag), (cache, cy_), (free, None)])
            row += 1
        legend = [("In use", used, T.magenta, "held by running apps"),
                  ("Cache", cache, T.cyan, "speeds up files, freed when needed"),
                  ("Free", free, T.dim, "completely unused")]
        left = iy + ih - row
        has_swap = m.swap_total > 0
        if left >= 3 + has_swap + 1:
            for name, val, col, why in legend:
                s.put(ix, row, "●", col)
                s.put(ix + 2, row, name, T.fg)
                s.put(ix + 9, row, fmt_bytes(val).rjust(8), T.bright)
                s.put(ix + 18, row, f"{val / m.total * 100:3.0f}%", T.dim)
                s.put(ix + 24, row, trunc(why, iw - 24), mix(T.dim, T.bg, 0.15))
                row += 1
        elif left >= 1 + has_swap:
            px = ix
            for name, val, col, _ in legend:
                t = f"{name} {fmt_bytes(val)}"
                if px + len(t) + 2 > ix + iw:
                    break
                s.put(px, row, "●", col)
                s.put(px + 2, row, t, T.fg)
                px += len(t) + 5
            row += 1
        if has_swap and row < iy + ih:
            sf = A("swap", m.swap_used / m.swap_total)
            lab = "Swap (zram)" if m.zram else "Swap"
            val = f"{fmt_bytes(m.swap_used)} / {fmt_bytes(m.swap_total)}"
            s.put(ix, row, lab, T.fg)
            self.meter(ix + len(lab) + 1, row, iw - len(lab) - len(val) - 2, sf, T.sev)
            s.put(ix + iw - len(val), row, val, T.dim)
            row += 1
        gh = iy + ih - row
        if gh >= 2:
            hist = list(m.hist)
            if hist:
                hist[-1] = A("mem_last", hist[-1])
            self.graph(ix, row, iw, gh, hist, lambda f: mix(T.magenta, T.red, max(0, f - 0.6)))

    def draw_net(self, x, y, w, h):
        s, T, n, A = self.scr, self.theme, self.net, self.anim
        right = n.iface or "offline"
        if n.signal is not None:
