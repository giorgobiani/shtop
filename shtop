        ix, iy, iw, ih = x + 2, y + 1, w - 4, h - 2
        down, up = A("down", n.down), A("up", n.up)
        d, u = f"↓ {fmt_rate(down)}", f"↑ {fmt_rate(up)}"
        s.put(ix, iy, d, T.cyan, bold=True)
        s.put(ix + len(d) + 1, iy, "download", T.dim)
        s.put(ix + iw - len(u), iy, u, T.magenta, bold=True)
        s.put(ix + iw - len(u) - 7, iy, "upload", T.dim)
        gh = ih - 2
        if gh >= 3:
            uh_ = gh // 2
            dh_ = gh - uh_ - 1
            axis = iy + 1 + dh_
            dvals, uvals = list(n.dh)[-iw:], list(n.uh)[-iw:]
            dmax = A("dmax", max(dvals + [16 * 1024]))
            umax = A("umax", max(uvals + [16 * 1024]))
            s.put(ix, axis, "─" * iw, mix(T.muted, T.bg, 0.3))
