class CPU:
    def __init__(self):
        self.threads = os.cpu_count() or 1
        self.model, self.cores = self._info()
        self.prev = None
        self.total = 0.0
        self.per = [0.0] * self.threads
        self.hist = deque(maxlen=1000)
        self.freq = None
        self.load = (0.0, 0.0, 0.0)
        self.running = 0

    def _info(self):
        txt = read("/proc/cpuinfo", "")
        m = re.search(r"^model name\s*:\s*(.+)$", txt, re.M)
        model = m.group(1) if m else "Processor"
        for pat in (r"\(R\)", r"\(TM\)", r"@.*$", r"\b\d+(st|nd|rd|th) Gen\b", r"\bCPU\b",
                    r"\bProcessor\b", r"\bwith Radeon.*$", r"\b\d+-Core\b", r"\s+Graphics$"):
            model = re.sub(pat, "", model, flags=re.I)
        model = re.sub(r"\s+", " ", model).strip()
        cores = {}
        for phys, cc in re.findall(r"physical id\s*:\s*(\d+).*?cpu cores\s*:\s*(\d+)", txt, re.S):
            cores[phys] = int(cc)
        return model, (sum(cores.values()) or self.threads)

    def _read(self):
        out = []
        with open("/proc/stat") as f:
            for line in f:
                if line.startswith("cpu"):
                    v = [int(x) for x in line.split()[1:9]]
                    out.append((sum(v), v[3] + v[4]))
                elif line.startswith("procs_running"):
                    self.running = int(line.split()[1])
        return out

    def update(self):
        cur = self._read()
        if self.prev and len(self.prev) == len(cur):
            pct = []
            for (t, i), (pt, pi) in zip(cur, self.prev, strict=True):
                dt = t - pt
                pct.append(0.0 if dt <= 0 else max(0.0, min(1.0, 1 - (i - pi) / dt)))
            self.total, self.per = pct[0], pct[1:]
            self.hist.append(self.total)
        self.prev = cur
        self.load = os.getloadavg()
        self.freq = self._freq()

    def _freq(self):
        vals = []
        for i in range(self.threads):
            v = read_int(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq")
            if v is None:
                break
            vals.append(v / 1e6)
        if vals:
            return sum(vals) / len(vals)
        mhz = re.findall(r"^cpu MHz\s*:\s*([\d.]+)", read("/proc/cpuinfo", ""), re.M)
        return sum(map(float, mhz)) / len(mhz) / 1000 if mhz else None


class Memory:
    def __init__(self):
        self.hist = deque(maxlen=1000)
        self.total = self.used = self.cache = self.free = self.avail = 1
        self.swap_total = self.swap_used = 0
        self.zram = "zram" in read("/proc/swaps", "")

    def update(self):
        m = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                m[k] = int(v.split()[0]) * 1024
        self.total = m["MemTotal"]
        self.free = m["MemFree"]
        self.avail = m.get("MemAvailable", self.free)
        self.used = self.total - self.avail
        self.cache = max(0, self.avail - self.free)
        self.swap_total = m.get("SwapTotal", 0)
        self.swap_used = self.swap_total - m.get("SwapFree", 0)
        self.hist.append(self.used / self.total)


class Network:
    VIRTUAL = ("lo", "veth", "docker", "br-", "virbr", "tun", "tap", "wg", "tailscale", "vnet")

    def __init__(self):
        self.prev = None
        self.down = self.up = 0.0
        self.rx_total = self.tx_total = 0
        self.dh, self.uh = deque(maxlen=1000), deque(maxlen=1000)
        self.iface, self.ip, self.signal = None, None, None
        self._ip_at = 0

    def _default_iface(self):
        try:
            with open("/proc/net/route") as f:
                for line in f.readlines()[1:]:
                    p = line.split()
                    if p[1] == "00000000" and int(p[3], 16) & 2:
                        return p[0]
        except OSError:
            pass
        return None

    def update(self, now):
        stats = {}
        with open("/proc/net/dev") as f:
            for line in f.readlines()[2:]:
                name, rest = line.split(":", 1)
                v = rest.split()
                stats[name.strip()] = (int(v[0]), int(v[8]))
        iface = self._default_iface()
        names = [iface] if iface in stats else [n for n in stats if not n.startswith(self.VIRTUAL)]
        rx = sum(stats[n][0] for n in names)
        tx = sum(stats[n][1] for n in names)
        if self.prev and self.prev[0] == names and now > self.prev[3]:
            dt = now - self.prev[3]
            self.down = max(0.0, (rx - self.prev[1]) / dt)
            self.up = max(0.0, (tx - self.prev[2]) / dt)
            self.dh.append(self.down)
            self.uh.append(self.up)
        self.prev = (names, rx, tx, now)
        self.rx_total, self.tx_total = rx, tx
        self.iface = iface
        self.signal = None
        if iface:
            for line in (read("/proc/net/wireless", "") or "").splitlines()[2:]:
                if line.strip().startswith(iface + ":"):
                    try:
                        self.signal = min(100, int(float(line.split()[2].rstrip(".")) / 70 * 100))
                    except (ValueError, IndexError):
                        pass
        if now - self._ip_at > 10:
            self._ip_at = now
            self.ip = None
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.connect(("1.1.1.1", 53))  # UDP connect: picks a route, sends nothing
                self.ip = s.getsockname()[0]
                s.close()
            except OSError:
                pass


class Disks:
    REAL_FS = {"ext2", "ext3", "ext4", "btrfs", "xfs", "vfat", "exfat", "ntfs", "ntfs3", "f2fs",
               "zfs", "bcachefs", "jfs", "fuseblk", "9p", "virtiofs", "nfs", "nfs4", "cifs", "smb3"}
    SKIP = ("/snap", "/var/lib/docker", "/run", "/proc", "/sys", "/var/lib/containers")

    def __init__(self):
        self.mounts = []
        self.read_rate = self.write_rate = 0.0
        self.prev = None

    def update(self, now):
        mounts, seen = [], set()
        with open("/proc/mounts") as f:
            for line in f:
                dev, mnt, fs = line.split()[:3]
                mnt = mnt.replace("\\040", " ")
                if fs not in self.REAL_FS or mnt.startswith(self.SKIP) or dev in seen:
                    continue
                seen.add(dev)
                try:
                    st = os.statvfs(mnt)
                except OSError:
                    continue
                if not st.f_blocks:
                    continue
                total = st.f_blocks * st.f_frsize
                avail = st.f_bavail * st.f_frsize
                used = total - st.f_bfree * st.f_frsize
                mounts.append({"mnt": mnt, "fs": fs, "total": total, "used": used, "free": avail,
                               "frac": used / (used + avail) if used + avail else 0.0})
        mounts.sort(key=lambda m: (m["mnt"] != "/", m["mnt"] != "/home", m["mnt"]))
        self.mounts = mounts

        try:
            phys = {d for d in os.listdir("/sys/block")
                    if not d.startswith(("loop", "ram", "zram", "dm-", "sr", "fd", "md"))}
            rd = wr = 0
            with open("/proc/diskstats") as f:
                for line in f:
                    p = line.split()
                    if p[2] in phys:
                        rd += int(p[5]) * 512
                        wr += int(p[9]) * 512
            if self.prev and now > self.prev[2]:
                dt = now - self.prev[2]
                self.read_rate = max(0.0, (rd - self.prev[0]) / dt)
                self.write_rate = max(0.0, (wr - self.prev[1]) / dt)
            self.prev = (rd, wr, now)
        except OSError:
            pass

    @staticmethod
    def label(mnt):
        return {"/": "System", "/home": "Home", "/boot": "Boot", "/efi": "EFI",
                "/boot/efi": "EFI"}.get(mnt, os.path.basename(mnt.rstrip("/")) or mnt)


class Sensors:
    GROUPS = {"coretemp": "CPU", "k10temp": "CPU", "zenpower": "CPU", "cpu_thermal": "CPU",
              "amdgpu": "GPU", "nouveau": "GPU", "radeon": "GPU", "nvme": "SSD", "drivetemp": "Disk",
              "acpitz": "Board", "iwlwifi_1": "Wi-Fi", "thinkpad": "Laptop", "spd5118": "RAM"}

    def __init__(self):
        self.temps = []   # [(label, celsius)]
        self.fans = []    # [(label, rpm)]
        self.cpu_temp = None

    def update(self):
        groups, fans = {}, []
        for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            name = read(h + "/name", "")
            label = self.GROUPS.get(name)
            if label is None and name.startswith("iwlwifi"):
                label = "Wi-Fi"
            for t in glob.glob(h + "/temp*_input"):
                v = read_int(t)
                if v is None or v <= 0:
                    continue
                c = v / 1000
                sub = read(t[:-6] + "_label", "") or ""
                if label == "CPU" and sub and not sub.startswith(("Package", "Tctl", "Tdie")):
                    groups["_cores"] = max(groups.get("_cores", 0), c)
                    continue
                key = label or name.replace("_", " ").title()
                groups[key] = max(groups.get(key, 0), c)
            for fpath in glob.glob(h + "/fan*_input"):
                rpm = read_int(fpath)
                if rpm:
                    fans.append((read(fpath[:-6] + "_label", "") or "Fan", rpm))
        if "CPU" not in groups and "_cores" in groups:
            groups["CPU"] = groups["_cores"]
        groups.pop("_cores", None)
        if "CPU" not in groups:
            for z in glob.glob("/sys/class/thermal/thermal_zone*"):
                if read(z + "/type") in ("x86_pkg_temp", "cpu-thermal", "soc_thermal"):
                    v = read_int(z + "/temp")
                    if v:
                        groups["CPU"] = v / 1000
        order = ["CPU", "GPU", "SSD", "Disk", "RAM", "Board", "Wi-Fi", "Laptop"]
        self.temps = sorted(groups.items(), key=lambda kv: order.index(kv[0]) if kv[0] in order else 99)
        self.fans = fans
        self.cpu_temp = groups.get("CPU")


class Battery:
    def __init__(self):
        self.present = False

    def update(self):
        bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
        self.present = bool(bats)
        if not bats:
            return
        b = bats[0]
        self.pct = read_int(b + "/capacity", 0)
        self.status = read(b + "/status", "Unknown")
        now = read_int(b + "/energy_now") or read_int(b + "/charge_now")
        full = read_int(b + "/energy_full") or read_int(b + "/charge_full")
        rate = read_int(b + "/power_now") or read_int(b + "/current_now")
        volts = read_int(b + "/voltage_now")
        self.watts = None
        if rate:
            self.watts = rate / 1e6 if read_int(b + "/power_now") else rate * (volts or 0) / 1e12
        self.time_left = None
        if rate and now and full:
            if self.status == "Discharging":
                self.time_left = now / rate * 3600
            elif self.status == "Charging":
                self.time_left = max(0, full - now) / rate * 3600
        self.plugged = any(read(p + "/online") == "1"
                           for p in glob.glob("/sys/class/power_supply/*")
                           if read(p + "/type") == "Mains")

    def icon(self):
        if self.status == "Charging":
            return ICON["CHARGING"]
        return BAT_ICONS[min(10, max(0, round(self.pct / 10)))]

    def describe(self):
        if self.status == "Charging":
            s = "Charging"
            if self.time_left:
                s += f" · full in {fmt_dur(self.time_left)}"
        elif self.status == "Discharging":
            s = "On battery"
            if self.time_left:
                s += f" · {fmt_dur(self.time_left)} left"
        elif self.status == "Full" or self.pct >= 99:
            s = "Plugged in · full"
        elif self.plugged:
            s = "Plugged in · not charging"
        else:
            s = self.status
        if self.watts and self.watts > 0.1:
            s += f" · {self.watts:.1f} W"
        return s


class GPU:
    def __init__(self):
        self.items = []  # [(name, busy_frac, vram_used, vram_total, temp)]
        self.nvidia = shutil.which("nvidia-smi")
        self._at = 0

    def update(self, now):
        items = []
        for dev in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
            busy = read_int(dev + "/gpu_busy_percent")
            if busy is None:
                continue
            items.append(("GPU", busy / 100, read_int(dev + "/mem_info_vram_used"),
                          read_int(dev + "/mem_info_vram_total"), None))
        if self.nvidia:
            if now - self._at >= 2:
                self._at = now
                try:
                    out = subprocess.run(
                        [self.nvidia, "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu",
                         "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=1).stdout
                    self._nv = []
                    for line in out.strip().splitlines():
                        u, mu, mt, t = [x.strip() for x in line.split(",")]
                        self._nv.append(("GPU", int(u) / 100, int(mu) << 20, int(mt) << 20, int(t)))
                except (OSError, ValueError, subprocess.SubprocessError):
                    self._nv = []
            items += getattr(self, "_nv", [])
        self.items = items


class Proc:
    __slots__ = ("pid", "ppid", "name", "cmd", "uid", "user", "state", "cpu", "mem",
                 "threads", "start", "kernel", "procs", "count", "key")


INTERPRETERS = {"python", "python2", "python3", "node", "bash", "sh", "zsh", "fish", "perl",
                "ruby", "lua", "luajit", "bun", "deno", "java", "uv", "uvx"}

STATES = {"R": "running", "S": "sleeping", "D": "waiting", "Z": "zombie", "T": "stopped",
          "t": "traced", "I": "idle", "X": "dead", "P": "parked"}
STATE_HELP = {"R": "actively using the CPU right now",
              "S": "waiting for something to do (normal)",
              "D": "waiting on disk or hardware — can't be interrupted",
              "Z": "finished, but its parent hasn't collected it yet",
              "T": "paused (e.g. with Ctrl+Z)",
              "I": "idle kernel task"}


class Procs:
    def __init__(self, ncpu):
        self.clk = os.sysconf("SC_CLK_TCK")
        self.page = os.sysconf("SC_PAGE_SIZE")
        self.ncpu = ncpu
        self.prev, self.prev_t = {}, None
        self.meta = {}
        self.users = {}
        self.list = []
        m = re.search(r"^btime (\d+)", read("/proc/stat", ""), re.M)
        self.btime = int(m.group(1)) if m else time.time()

    def user(self, uid):
        if uid not in self.users:
            try:
                self.users[uid] = pwd.getpwuid(uid).pw_name
            except KeyError:
                self.users[uid] = str(uid)
        return self.users[uid]

    @staticmethod
    def _name(comm, argv):
        if not argv or not argv[0]:
            return comm
        a0 = argv[0]
        if len(argv) == 1 and " " in a0 and not os.path.exists(a0):
            a0 = a0.split(" ")[0]
        base = os.path.basename(a0).lstrip("-").rstrip(":") or comm
        stem = re.sub(r"[\d.]+$", "", base)
        if base in INTERPRETERS or stem in INTERPRETERS:
            it = iter(argv[1:])
            for a in it:
                if a == "-m":
                    return next(it, base)
                if a == "-c":
                    return base
                if not a.startswith("-"):
                    return os.path.basename(a.rstrip("/")) or base
            return base
        return base

    def update(self, now):
        dt = now - self.prev_t if self.prev_t else None
        cur, out, meta = {}, [], {}
        for d in os.listdir("/proc"):
            if not d.isdigit():
                continue
            try:
                with open(f"/proc/{d}/stat", "rb") as f:
                    raw = f.read().decode(errors="replace")
            except OSError:
                continue
            lp, rp = raw.find("("), raw.rfind(")")
            comm, v = raw[lp + 1:rp], raw[rp + 2:].split()
            pid, ppid = int(d), int(v[1])
            ticks, start = int(v[11]) + int(v[12]), int(v[19])
            key = (pid, start)
            m = self.meta.get(key)
            if m is None or m[4] != comm:
                kernel = ppid == 2 or pid == 2
                argv = []
                if not kernel:
                    try:
                        with open(f"/proc/{d}/cmdline", "rb") as f:
                            argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
                    except OSError:
                        pass
                try:
                    uid = os.stat(f"/proc/{d}").st_uid
                except OSError:
                    uid = -1
                m = (self._name(comm, argv), " ".join(argv) or f"[{comm}]", uid, kernel, comm)
            meta[key] = m
            cur[key] = ticks
            p = Proc()
            p.pid, p.ppid, p.start = pid, ppid, start
            p.name, p.cmd, p.uid, p.kernel = m[0], m[1], m[2], m[3]
            p.user = self.user(p.uid)
            p.state = v[0]
            p.threads = int(v[17])
            p.mem = int(v[21]) * self.page
            p.cpu = 0.0
            if dt and key in self.prev:
                p.cpu = max(0.0, (ticks - self.prev[key]) / self.clk / dt / self.ncpu)
            p.procs, p.count, p.key = [p], 1, pid
            out.append(p)
        self.meta, self.prev, self.prev_t, self.list = meta, cur, now, out


def group(procs):
    groups = {}
    for p in procs:
        groups.setdefault(p.name, []).append(p)
    out = []
    order = {"R": 0, "D": 1, "S": 2, "I": 3, "T": 4, "Z": 5}
    for name, members in groups.items():
        members.sort(key=lambda p: p.pid)
        g = Proc()
        g.name, g.key, g.procs, g.count = name, name, members, len(members)
        g.pid, g.ppid, g.start = members[0].pid, members[0].ppid, members[0].start
        g.cmd, g.kernel = members[0].cmd, members[0].kernel
        g.cpu = sum(p.cpu for p in members)
        g.mem = sum(p.mem for p in members)
        g.threads = sum(p.threads for p in members)
        users = {p.user for p in members}
        g.user = users.pop() if len(users) == 1 else "several"
        g.uid = members[0].uid
        g.state = min((p.state for p in members), key=lambda s: order.get(s, 9))
        out.append(g)
    return out


