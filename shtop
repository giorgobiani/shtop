class Anim:
    """Eases every displayed number towards its real value so nothing jumps."""

    TAU = 0.07  # seconds; ~90% of the way in a quarter second

    def __init__(self):
        self.v = {}
        self.t = time.monotonic()
        self.k = 1.0
        self.active = False
        self.enabled = True

    def step(self):
        now = time.monotonic()
        dt, self.t = now - self.t, now
        self.k = 1.0 if not self.enabled else 1 - math.exp(-max(0.0, dt) / self.TAU)
        self.active = False

    def __call__(self, key, target):
        d = self.v.get(key)
        if d is None or self.k >= 1.0:
            self.v[key] = target
            return target
        d += (target - d) * self.k
        if abs(target - d) <= abs(target) * 0.01 + 1e-3:
            d = target
        else:
            self.active = True
        self.v[key] = d
        return d


