    # ── layout ──
    def render(self):
        s, T = self.scr, self.theme
        self.anim.step()
        s.clear()
        W, H = s.w, s.h
        if W < 60 or H < 15:
            msg = "shtop needs a bit more room"
            s.put(max(0, (W - len(msg)) // 2), H // 2, msg, T.fg)
            sub = f"{W}×{H} — at least 60×15"
            s.put(max(0, (W - len(sub)) // 2), H // 2 + 1, sub, T.dim)
            return
        self.draw_header(W)
        avail = H - 2
        y = 1
        top_h = max(7, min(14, int(avail * 0.32)))
        mid_h = max(6, min(9, int(avail * 0.24))) if avail >= 24 else 0
        if avail - top_h - mid_h < 7:
            mid_h = 0
        if avail - top_h < 6:
            top_h = max(5, avail - 6)
        cw = W * 56 // 100 if W >= 100 else W // 2
        self.draw_cpu(0, y, cw, top_h)
        self.draw_mem(cw, y, W - cw, top_h)
        y += top_h
        if mid_h:
            if W >= 110:
                a = W // 3
                self.draw_net(0, y, a, mid_h)
                self.draw_disks(a, y, a, mid_h)
                self.draw_sys(2 * a, y, W - 2 * a, mid_h)
            else:
                self.draw_net(0, y, W // 2, mid_h)
                self.draw_disks(W // 2, y, W - W // 2, mid_h)
            y += mid_h
        self.draw_procs(0, y, W, H - 1 - y)
        self.draw_footer(W, H)
        if self.overlay == "detail":
            self.draw_detail()
        elif self.overlay == "confirm":
            self.draw_confirm()
        elif self.overlay == "help":
            self.draw_help()

    # ── input ──
    def ask_kill(self, sig):
        r = self.current()
        if r:
            self.confirm = (r, sig)
            self.overlay = "confirm"

    def on_key(self, k):
        if k == "ctrl-c":
            self.running = False
            return
        if isinstance(k, tuple):
            return self.on_mouse(*k[1:])
        if self.filtering:
            if k == "enter" or k in ("up", "down"):
                self.filtering = False
                if k != "enter":
                    self.move(-1 if k == "up" else 1)
            elif k == "esc":
                self.filter, self.filtering = "", False
            elif k == "backspace":
                self.filter = self.filter[:-1]
            elif len(k) == 1 and k.isprintable():
                self.filter += k
                self.sel, self.sel_key = 0, None
            self.build_rows()
            return
        if self.overlay == "confirm":
            if k in ("y", "Y", "enter"):
                self.kill(*self.confirm)
                self.overlay = None
            elif k in ("n", "N", "esc", "q"):
                self.overlay = None
            return
        if self.overlay == "help":
            self.overlay = None
            return
        if self.overlay == "detail":
            if k in ("esc", "enter", "q", "left", "backspace"):
                self.overlay = None
            elif k in ("delete", "x"):
                self.ask_kill(signal.SIGTERM)
            elif k in ("shift-delete", "X"):
                self.ask_kill(signal.SIGKILL)
            elif k in ("up", "k"):
                self.move(-1)
            elif k in ("down", "j"):
                self.move(1)
            return
        vis = self.table[1] if self.table else 10
        if k in ("q", "Q"):
            self.running = False
        elif k == "esc":
            if self.filter:
                self.filter = ""
                self.build_rows()
        elif k in ("up", "k"):
            self.move(-1)
        elif k in ("down", "j"):
            self.move(1)
        elif k == "pgup":
            self.move(-vis)
        elif k == "pgdn":
            self.move(vis)
        elif k == "home":
            self.move(-len(self.rows))
        elif k in ("end", "G"):
            self.move(len(self.rows))
        elif k in ("enter", "right", "l"):
            if self.current():
                self.overlay = "detail"
        elif k == "/":
            self.filtering = True
        elif k == "g":
            self.grouped = not self.grouped
            r = self.current()
            self.sel_key = (r.procs[0].pid if not self.grouped else r.name) if r else None
            if self.sort == "count" and not self.grouped:
                self.sort = "cpu"
            self.build_rows()
        elif k == "s":
            opts = [o for o in SORTS if self.grouped or o != "count"]
            self.sort = opts[(opts.index(self.sort) + 1) % len(opts)] if self.sort in opts else "cpu"
            self.reverse = False
            self.build_rows()
        elif k in ("c", "m", "n", "p"):
            new = {"c": "cpu", "m": "mem", "n": "name", "p": "pid"}[k]
            self.reverse = not self.reverse if self.sort == new else False
            self.sort = new
            self.build_rows()
        elif k == "r":
            self.reverse = not self.reverse
            self.build_rows()
        elif k == "t":
            self.show_kernel = not self.show_kernel
            self.say("Showing kernel tasks" if self.show_kernel else "Hiding kernel tasks")
            self.build_rows()
        elif k == "a":
            self.anim.enabled = not self.anim.enabled
            self.say("Animations on" if self.anim.enabled else "Animations off — numbers update instantly")
        elif k in ("+", "="):
            self.interval = max(0.5, self.interval / 2)
            self.say(f"Updating every {self.interval:g}s")
        elif k in ("-", "_"):
            self.interval = min(8.0, self.interval * 2)
            self.say(f"Updating every {self.interval:g}s")
        elif k in ("delete", "x"):
            self.ask_kill(signal.SIGTERM)
        elif k in ("shift-delete", "X"):
            self.ask_kill(signal.SIGKILL)
        elif k in ("?", "h", "f1"):
            self.overlay = "help"

    def on_mouse(self, btn, mx, my, press):
        if not press:
            return
        if self.overlay:
            if btn == 0 and self.overlay in ("help", "detail"):
                self.overlay = None
            return
        if btn == 64:
            self.move(-3)
            return
        if btn == 65:
            self.move(3)
            return
        if btn != 0 or not self.table:
            return
        y0, vis, scroll, hy = self.table
        x, y = mx - 1, my - 1
        if y == hy:
            for a, b, key in self.header_hits:
                if a <= x < b:
                    if key == "count":
                        self.sort, self.reverse = "count", False
                        self.build_rows()
                    else:
                        self.on_key({"cpu": "c", "mem": "m", "name": "n", "pid": "p"}[key])
            return
        if y0 <= y < y0 + vis:
            i = scroll + (y - y0)
            if i < len(self.rows):
                now = time.monotonic()
                key = self.rows[i].key
                if self.sel == i and self.last_click[1] == key:
                    self.overlay = "detail"
                self.sel, self.sel_key, self.picked = i, key, True
                self.last_click = (now, key)


# ───────────────────────────── terminal loop ────────────────────────

KEYMAP = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end",
          "1~": "home", "7~": "home", "4~": "end", "8~": "end", "5~": "pgup", "6~": "pgdn",
          "3~": "delete", "3;2~": "shift-delete", "11~": "f1", "P": "f1"}
CSI = re.compile(r"\x1b\[([0-9;]*)([A-Za-z~])")
MOUSE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([mM])")


def parse_keys(data):
    keys, i = [], 0
    while i < len(data):
        c = data[i]
        if c == "\x1b":
            m = MOUSE.match(data, i)
            if m:
                keys.append(("mouse", int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4) == "M"))
                i = m.end()
                continue
            m = CSI.match(data, i)
            if m:
                code = m.group(1) + "~" if m.group(2) == "~" else m.group(2)
                keys.append(KEYMAP.get(code, "?unknown"))
                i = m.end()
                continue
            if data.startswith("\x1bO", i) and i + 2 < len(data):
                keys.append(KEYMAP.get(data[i + 2], "?unknown"))
                i += 3
                continue
            keys.append("esc")
            i += 1
        elif c in "\r\n":
            keys.append("enter")
            i += 1
        elif c in "\x7f\x08":
            keys.append("backspace")
            i += 1
        elif c == "\x03":
            keys.append("ctrl-c")
            i += 1
        elif c == "\t":
            keys.append("tab")
            i += 1
        else:
            keys.append(c)
            i += 1
    return [k for k in keys if k != "?unknown"]


FRAME = 1 / 24  # animation frame time


def run(opts):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        sys.exit("shtop needs to run in a terminal")
    fd, out = sys.stdin.fileno(), sys.stdout.fileno()
    old = termios.tcgetattr(fd)
    tty.setraw(fd)
    try:
        palette = query_terminal_palette(fd, out) if theme_file()[0] is None else None
        app = App(Theme(palette), interval=opts.interval, animate=not opts.no_animation)
    except BaseException:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        raise
    rpipe, wpipe = os.pipe()
    os.set_blocking(wpipe, False)
    os.set_blocking(rpipe, False)
    signal.set_wakeup_fd(wpipe)
    flags = {"resize": True, "theme": False}
    signal.signal(signal.SIGWINCH, lambda *_: flags.__setitem__("resize", True))
    signal.signal(signal.SIGUSR2, lambda *_: flags.__setitem__("theme", True))
    signal.signal(signal.SIGTERM, lambda *_: setattr(app, "running", False))

    os.write(out, b"\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h\x1b]0;shtop\x07\x1b[2J")
    try:
        app.sample_fast()
        app.sample()
        now = time.monotonic()
        next_fast = now + 0.25  # quick second sample so numbers appear fast
        next_slow = now + 0.3
        next_theme = now + 0.5
        dirty = True
        while app.running:
            now = time.monotonic()
            if flags["resize"]:
                flags["resize"] = False
                sz = shutil.get_terminal_size()
                app.scr.resize(sz.columns, sz.lines)
                os.write(out, b"\x1b[0m\x1b[2J")
                dirty = True
            if flags["theme"] or now >= next_theme:
                next_theme = now + 0.5
                if flags["theme"] or app.theme.changed():
                    flags["theme"] = False
                    old_name = app.theme.name
                    app.theme.load()
                    app.scr.prev = None
                    if app.theme.name != old_name:
                        app.say(f"Theme changed to {app.theme.name}", app.theme.accent)
                    dirty = True
            if now >= next_fast:
                app.sample_fast()
                next_fast = now + app.fast_interval
                dirty = True
            if now >= next_slow:
                app.sample()
                next_slow = now + app.interval
                dirty = True
            if app.toast and now >= app.toast_until:
                app.toast = None
                dirty = True
            if dirty or app.anim.active:
                app.render()
                app.scr.flush()
                dirty = False
            wake = min(next_fast, next_slow, next_theme)
            if app.anim.active:
                wake = min(wake, time.monotonic() + FRAME)
            timeout = max(0.0, wake - time.monotonic())
            try:
                ready, _, _ = select.select([fd, rpipe], [], [], timeout)
            except InterruptedError:
                ready = []
            if rpipe in ready:
                try:
                    os.read(rpipe, 1024)
                except BlockingIOError:
                    pass
            if fd in ready:
                data = os.read(fd, 4096).decode(errors="ignore")
                for k in parse_keys(data):
                    app.on_key(k)
                    if not app.running:
                        break
                dirty = True
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        os.write(out, b"\x1b[?1006l\x1b[?1000l\x1b[0m\x1b[?7h\x1b[?25h\x1b[?1049l")


def dump(w, h, opts):
    """Render one frame to stdout, e.g. for screenshots: shtop --dump 120x40"""
    app = App(interval=opts.interval, animate=False)
    app.sample_fast()
    app.sample()
    n = int(os.environ.get("SHTOP_DUMP_SAMPLES", "3"))
    for i in range(n * 2):
        time.sleep(0.25)
        app.sample_fast()
        if i % 2:
            app.sample()
    app.scr.resize(w, h)
    app.overlay = os.environ.get("SHTOP_DUMP_OVERLAY") or None
    if app.overlay == "confirm":
        app.confirm = (app.current(), signal.SIGTERM)
    if os.environ.get("SHTOP_DUMP_FILTER"):
        app.filter = os.environ["SHTOP_DUMP_FILTER"]
        app.filtering = True
        app.build_rows()
    app.render()
    sys.stdout.write(app.scr.dump())


def size(spec):
    m = re.fullmatch(r"(\d+)x(\d+)", spec.lower())
    if not m:
        raise argparse.ArgumentTypeError("expected COLUMNSxROWS, e.g. 120x40")
    return int(m.group(1)), int(m.group(2))


def interval(spec):
    try:
        v = float(spec)
    except ValueError:
        raise argparse.ArgumentTypeError("expected a number of seconds") from None
    if not 0.5 <= v <= 8:
        raise argparse.ArgumentTypeError("must be between 0.5 and 8 seconds")
    return v


def parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="shtop",
        description="A calm, readable system monitor for the terminal.",
        epilog="Inside shtop, press ? for a guide to every panel and key. "
               "Colours follow the current Omarchy theme, ~/.config/shtop/colors.toml, "
               "or your terminal's palette.")
    p.add_argument("-i", "--interval", type=interval, default=1.0, metavar="SECONDS",
                   help="how often processes and drives refresh (0.5–8, default 1)")
    p.add_argument("--no-animation", action="store_true",
                   help="update numbers instantly instead of easing them (uses less CPU)")
    icons = p.add_mutually_exclusive_group()
    icons.add_argument("--icons", dest="icons", action="store_const", const=True,
                       help="use Nerd Font icons (default when a Nerd Font is installed)")
    icons.add_argument("--no-icons", dest="icons", action="store_const", const=False,
                       help="use plain symbols that work with any font")
    p.add_argument("--dump", type=size, metavar="COLSxROWS",
                   help="print a single frame of that size and exit")
    p.add_argument("-V", "--version", action="version", version=f"shtop {VERSION}")
    return p.parse_args(argv)


def main(argv=None):
    opts = parse_args(argv)
    icons = opts.icons
    if icons is None:
        env = os.environ.get("SHTOP_ICONS", "").lower()
        icons = env in ("1", "yes", "true", "on") if env else nerd_font_installed()
    use_icons(icons)
    if opts.dump:
        return dump(*opts.dump, opts)
    try:
        run(opts)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
