# Maintainer: Shota Giorgobiani <shota at giorgobiani dot ge>
#
# Same recipe as the AUR package: builds the latest release.
#   cd packaging/arch && makepkg -si

pkgname=shtop
pkgver=1.0.0
pkgrel=1
pkgdesc='Calm, readable terminal system monitor that explains what your computer is doing'
arch=('any')
url='https://github.com/giorgobiani/shtop'
license=('MIT')
depends=('python')
optdepends=('ttf-nerd-fonts-symbols-mono: icons in any terminal font'
            'nvidia-utils: NVIDIA GPU usage')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f222703c9d680422e20cb7318cb0ae4626433bfc29de08d7dffadee8242e95ca')

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
