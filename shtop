def hex2rgb(s):
    s = s.strip().lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))


def mix(a, b, t):
    t = 0.0 if t < 0 else 1.0 if t > 1 else round(t, 3)
    key = (a, b, t)
    c = _mix_cache.get(key)
    if c is None:
        if len(_mix_cache) > 50000:
            _mix_cache.clear()
        c = _mix_cache[key] = _mix(a, b, t)
    return c


_mix_cache = {}


def _mix(a, b, t):
    return (round(a[0] + (b[0] - a[0]) * t),
            round(a[1] + (b[1] - a[1]) * t),
            round(a[2] + (b[2] - a[2]) * t))


def ramp(stops, t):
    t = max(0.0, min(1.0, t))
    n = len(stops) - 1
    i = min(int(t * n), n - 1)
    return mix(stops[i], stops[i + 1], t * n - i)


def theme_file():
    """The colors.toml to use and what kind of source it is, or (None, None)."""
    for path, kind in ((os.environ.get("SHTOP_THEME"), "custom"),
                       (USER_THEME, "custom"),
                       (OMARCHY_THEME, "omarchy")):
        if path and os.path.isfile(path):
            return path, kind
    return None, None


def luminance(rgb):
    return (0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]) / 255


OSC_COLOR = re.compile(r"\x1b\](10|11|4;(\d+));rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)")
DA1_REPLY = re.compile(r"\x1b\[\?[\d;]*c")


def parse_palette(reply):
    """Turn a terminal's OSC 4/10/11 replies into colors.toml-style entries."""
    found = {}
    for m in OSC_COLOR.finditer(reply):
        chans = []
        for part in m.group(3, 4, 5):
            chans.append(round(int(part, 16) * 255 / ((1 << (4 * len(part))) - 1)))
        key = {"10": "fg", "11": "bg"}.get(m.group(1))
        found[key if key else int(m.group(2))] = tuple(chans)
    if "fg" not in found or "bg" not in found:
        return None
    fg, bg = found["fg"], found["bg"]
    dark = luminance(bg) < 0.5
    base = {k: hex2rgb(v) for k, v in FALLBACK.items()}

    def pick(i, name):
        c = found.get(i)
        # ignore palette entries that would be unreadable on this background
        if c is None or abs(luminance(c) - luminance(bg)) < 0.12:
            return base[name]
        return c

    muted = found.get(8)
    if muted is None or abs(luminance(muted) - luminance(bg)) < 0.1:
        muted = _mix(fg, bg, 0.62)
    colors = {
        "background": bg, "foreground": fg,
        "red": pick(1, "red"), "green": pick(2, "green"), "yellow": pick(3, "yellow"),
        "blue": pick(4, "blue"), "magenta": pick(5, "magenta"), "cyan": pick(6, "cyan"),
        "muted": muted,
        "dark_foreground": _mix(fg, bg, 0.42),
        "bright_foreground": _mix(fg, (255, 255, 255) if dark else (0, 0, 0), 0.3),
        "selection": _mix(bg, fg, 0.14),
        "lighter_background": _mix(bg, fg, 0.07),
    }
    colors["accent"] = colors["blue"]
    out = {k: "#{:02x}{:02x}{:02x}".format(*v) for k, v in colors.items()}
    out["mode"] = "dark" if dark else "light"
    return out


def query_terminal_palette(fd_in, fd_out, timeout=0.3):
    """Ask the terminal for its colours (needs raw mode). Returns parse_palette() or None.

    Ends with a Primary Device Attributes request, which every terminal answers,
    so we know when the replies are complete without waiting for the timeout."""
    query = "\x1b]10;?\x1b\\\x1b]11;?\x1b\\" + "".join(f"\x1b]4;{i};?\x1b\\" for i in range(16)) + "\x1b[c"
    try:
        os.write(fd_out, query.encode())
    except OSError:
        return None
    reply, end = "", time.monotonic() + timeout
    while time.monotonic() < end:
        ready, _, _ = select.select([fd_in], [], [], max(0.0, end - time.monotonic()))
        if not ready:
            break
        reply += os.read(fd_in, 4096).decode(errors="ignore")
        if DA1_REPLY.search(reply):
            break
    return parse_palette(reply)


class Theme:
    def __init__(self, terminal_palette=None):
        self.terminal = terminal_palette
        self.stamp = None
        self.load()

    def _stamp(self):
        path, _ = theme_file()
        if path is None:
            # Omarchy swaps theme directories with rm + mv; don't fall back to the
            # terminal palette during that instant.
            if self.kind == "omarchy" and os.path.isdir(OMARCHY_STATE):
                return self.stamp
            return None
        try:
            st = os.stat(path)
            return (path, st.st_ino, st.st_mtime_ns, st.st_size)
        except OSError:
            return None

    def changed(self):
        return self._stamp() != self.stamp

    def load(self):
        path, kind = theme_file()
        data = {}
        if path:
            try:
                with open(path, "rb") as f:
                    data = tomllib.load(f)
            except (OSError, tomllib.TOMLDecodeError):
                data = {}
        elif self.terminal:
            data, kind = self.terminal, "terminal"
        self.kind = kind or "default"
        self.mode = data.get("mode", "dark")
        raw = {k: v for k, v in data.items() if isinstance(v, str) and v.startswith("#")}
        c = {}
        for k, v in {**FALLBACK, **raw}.items():
            try:
                c[k] = hex2rgb(v)
            except ValueError:
                c[k] = hex2rgb(FALLBACK[k]) if k in FALLBACK else None
        self.fg = c["foreground"]
        self.dim = c["dark_foreground"]
        self.bright = c["bright_foreground"]
        self.muted = c["muted"]
        self.sel = c["selection"]
        self.accent = c["accent"]
        self.bg = c["background"]
        self.red, self.yellow, self.green = c["red"], c["yellow"], c["green"]
        self.cyan, self.blue, self.magenta = c["cyan"], c["blue"], c["magenta"]
        self.orange = c.get("orange") or mix(self.red, self.yellow, 0.5)
        # The empty part of a meter: a touch stronger than the selection colour so
        # it stays visible on the selected row too.
        self.track = mix(self.sel, self.muted, 0.35)
        self.name = {"custom": "custom colors", "terminal": "terminal colors",
                     "default": "default colors"}.get(self.kind, "")
        if self.kind == "omarchy":
            name = read(OMARCHY_THEME_NAME, "") or ""
            self.name = name.replace("-", " ").title() or "Omarchy"
        self.stamp = None
        self.stamp = self._stamp()

    def sev(self, f):
        """green → yellow → red as f goes 0 → 1 (stays green below half)."""
        if f < 0.5:
            return self.green
        if f < 0.8:
            return mix(self.green, self.yellow, (f - 0.5) / 0.3)
        return mix(self.yellow, self.red, (f - 0.8) / 0.2)

    def fade(self, c, t=0.55):
        """c pushed towards the background — for the low end of gradients."""
        return mix(c, self.bg, t)

    def temp(self, c):
        return self.sev((c - 35) / 60)


