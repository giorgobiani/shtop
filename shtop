        need = 4 + sum(len(textwrap.wrap(t, w - 19)) + 1 for *_, t in sections) + 1 + (len(keys) + 1) // 2
        ix, iy, iw, ih = self.modal(w, need, "shtop guide", T.accent, ICON["LOGO"])
